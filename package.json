    "react-dom": "19.2.8",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/ui": "4.1.11",
    "jsdom": "30.0.1",
    "oxlint": "1.81.0",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
